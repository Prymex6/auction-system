APP_NAME="Gołębiowy Lot"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pigeon_auction
DB_USERNAME=root
DB_PASSWORD=

# Cache & Session & Queue
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://example.com/auth/facebook/callback

# Pusher (WebSockets for real-time)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Or use Reverb instead
LARAVEL_REVERB_SERVER_HOST=0.0.0.0
LARAVEL_REVERB_SERVER_PORT=8080
LARAVEL_REVERB_SERVER_SCHEME=http
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# 2FA
GOOGLE2FA_WINDOW=2
GOOGLE2FA_ENABLED=true

# Vite
# Same origin as the site unless the API lives somewhere else.
VITE_API_BASE_URL=/api
VITE_REVERB_HOST=reverb.example.com
VITE_REVERB_PORT=443

# Broadcast
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Wygeneruj przez: php -r "require 'vendor/autoload.php'; print_r(\Minishlink\WebPush\VAPID::createVapidKeys());"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com

VITE_APP_NAME="${APP_NAME}"

# Who runs this instance. The terms of service and the privacy notice have to
# name a real operator with a real address, so they are set here rather than
# written into the code.
PLATFORM_OPERATOR_NAME=
PLATFORM_OPERATOR_ADDRESS=
PLATFORM_OPERATOR_CITY=
PLATFORM_OPERATOR_POSTAL_CODE=
PLATFORM_OPERATOR_COUNTRY=PL
PLATFORM_EMAIL=
PLATFORM_PHONE=

# Seeding refuses to create an account without a password, so that no
# installation ever starts with one that is written down in the repository.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
